+"""Faster versions of work the tracker does on every frame, each giving exactly the same result as the code it replaces.
+
+- draw_obj_mask_roi: TrackedObject.draw_obj_mask restricted to the bounding box of the mask (the debug video pixels are
+  the same; the full-frame version allocates a 1920x1080 colour frame and runs three bitwise operations over the whole
+  frame for every object).
+- AsyncVideoWriter: cv2.VideoWriter whose encoding runs in a background thread (the same frames in the same order, so
+  the same file).
+- estimate_sigma_rgb: skimage estimate_sigma(image, average_sigmas=True, channel_axis=-1) computing only the diagonal
+  wavelet band it uses, one thread per channel (bit-identical result).
+"""
+import queue
+import threading
+from concurrent.futures import ThreadPoolExecutor
+
+import cv2
+import numpy as np
+
+
+def draw_obj_mask_roi(tracked_obj, img_to_draw, color=None):
+    """ Draws the object mask on the frame in place, only inside the bounding box of the mask.
+    Outside that box the full-frame TrackedObject.draw_obj_mask leaves every pixel unchanged
+    ((color & 0) | (pixel & 255)); inside it, the same three bitwise operations run on the box.
+    Args:
+        :param tracked_obj: TrackedObject (Airplane / Vehicle) with a segmentation mask
+        :param img_to_draw: BGR frame, modified in place
+        :param color: BGR color of the mask, (0, 255, 0) by default
+    Returns:
+        :return: the same frame
+    """
+    mask = tracked_obj._TrackedObject__segmenter.mask  # TrackedObject has no public accessor for the mask
+    if mask is None:
+        return img_to_draw
+    if color is None:
+        color = (0, 255, 0)
+    x, y, w, h = cv2.boundingRect(mask)
+    if w and h:
+        roi_mask = mask[y:y + h, x:x + w]
+        roi = img_to_draw[y:y + h, x:x + w]
+        color_image = np.full((h, w, 3), color, dtype=np.uint8)
+        fg = cv2.bitwise_or(color_image, color_image, mask=roi_mask)
+        bk = cv2.bitwise_or(roi, roi, mask=cv2.bitwise_not(roi_mask))
+        img_to_draw[y:y + h, x:x + w] = cv2.bitwise_or(fg, bk)
+    return img_to_draw
+
+
+class AsyncVideoWriter:
+    """ cv2.VideoWriter that encodes in a background thread. Frames are written in the order they are given;
+    a frame must not be changed after write(). release() writes the rest and closes the file. """
+
+    def __init__(self, *args, max_queue=16):
+        self._writer = cv2.VideoWriter(*args)
+        self._queue = queue.Queue(maxsize=max_queue)
+        self._error = None
+        self._thread = threading.Thread(target=self._run, name='video-writer', daemon=True)
+        self._thread.start()
+
+    def _run(self):
+        while True:
+            frame = self._queue.get()
+            if frame is None:
+                break
+            try:
+                self._writer.write(frame)
+            except Exception as e:  # raised in the caller's thread on the next write() or release()
+                self._error = e
+
+    def write(self, frame):
+        if self._error is not None:
+            raise self._error
+        self._queue.put(frame)
+
+    def release(self):
+        self._queue.put(None)
+        self._thread.join()
+        self._writer.release()
+        if self._error is not None:
+            raise self._error
+
+    def isOpened(self):
+        return self._writer.isOpened()
+
+
+_SIGMA_POOL = None
+
+
+def _channel_sigma(channel):
+    """ skimage _sigma_est_dwt(pywt.dwtn(channel, 'db2')['dd']) without the three sub-bands it drops: the same
+    PyWavelets routine in the same axis order (axis 0, then axis 1), so 'dd' is bit-identical. """
+    import pywt
+    import scipy.stats
+
+    xt = np.ascontiguousarray(np.asarray(channel).T, dtype=np.float64)  # axis 0 of the frame is now the last axis
+    d0 = np.ascontiguousarray(pywt.dwt(xt, 'db2', mode='symmetric', axis=1)[1].T)  # detail along the frame's axis 0
+    dd = pywt.dwt(d0, 'db2', mode='symmetric', axis=1)[1]  # then along axis 1 -> the 'dd' band
+    return np.median(np.abs(dd[dd != 0])) / scipy.stats.norm.ppf(0.75)
+
+
+def estimate_sigma_rgb(image):
+    """ Bit-identical to skimage estimate_sigma(image, average_sigmas=True, channel_axis=-1) for an HxWx3 frame:
+    the median does not depend on the order of the elements and the channel mean is taken in the same order. """
+    global _SIGMA_POOL
+    if _SIGMA_POOL is None:
+        _SIGMA_POOL = ThreadPoolExecutor(max_workers=3, thread_name_prefix='sigma')
+    sigmas = list(_SIGMA_POOL.map(_channel_sigma, [image[:, :, c] for c in range(image.shape[2])]))
+    return np.mean(sigmas)
