-        image_data = image.clone()
-        image_data = image_data.permute(2, 0, 1)
+        # transpose the image data from HWC to CHW (a view; no clone needed: the channel gather below copies, so the
+        # in-place normalisation never touches the caller's tensor)
+        image_data = image.permute(2, 0, 1)
         # convert bgr to rgb
         image_data = image_data[[2, 1, 0], :, :]
         # Normalize the image data
@@ -357,8 +362,15 @@ class YOLOv8_onnx():
             self.x_factor = torch.tensor(self.img_width / self.new_width, dtype=torch.float32, device=self._device_type)
