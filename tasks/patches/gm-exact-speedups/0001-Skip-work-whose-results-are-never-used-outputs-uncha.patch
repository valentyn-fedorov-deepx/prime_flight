-        # preprocess the image
-        image_data = self.preprocess(image, self.new_width, self.new_height, self.padding).contiguous()
+        # preprocess the image; heads with the same input size (GM and vehicle, 1088) share one preprocessed tensor of
+        # the same frame: the same operations on the same input give the same tensor, computed once
+        key = (self.new_width, self.new_height, tuple(self.padding))
+        cached = YOLOv8_onnx._preprocessed.get(key)
+        if cached is not None and cached[0] is image:
+            image_data = cached[1]
+        else:
+            image_data = self.preprocess(image, self.new_width, self.new_height, self.padding).contiguous()
+            YOLOv8_onnx._preprocessed[key] = (image, image_data)
 
         # bind the input
         self.binding.bind_input(
@@ -426,18 +438,20 @@ class YOLOv8_onnx():
 
