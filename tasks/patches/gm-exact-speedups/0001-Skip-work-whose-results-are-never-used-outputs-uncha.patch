         indices = torch.ops.torchvision.nms(boxes, scores, torch.tensor(self._iou_thres).cuda().float())
-        detections = []
-        for i in indices:
-            detections.append([*boxes[i], scores[i], classes[i]])
-        
-        # convert detections to numpy
-        detections = torch.tensor(detections).cpu().numpy()
-        
-        # print the results like the original YOLOv8
-        print(f'Device id: {self._device_id}; Image size: {self.new_width}x{self.new_height}; {len(detections)} detects')
-        print(f'Speed: {round((inference_time - preprocess_time) * 1000, 1)} ms preprocess, '
