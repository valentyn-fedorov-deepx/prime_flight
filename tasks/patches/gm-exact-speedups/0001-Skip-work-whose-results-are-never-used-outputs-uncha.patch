+        else:
+            detections = np.zeros((0,), dtype=np.float32)
+
+        if VERBOSE:  # the per-frame timing lines of the original YOLOv8 printout
+            print(f'Device id: {self._device_id}; Image size: {self.new_width}x{self.new_height}; {len(detections)} detects')
+            print(f'Speed: {round((inference_time - preprocess_time) * 1000, 1)} ms preprocess, '
+                  f'{round((postprocess_time - inference_time) * 1000, 1)} ms inference, '
+                  f'{round((time.time() - postprocess_time) * 1000, 1)} ms postprocess')
         return detections
 
 
